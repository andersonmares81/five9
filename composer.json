{
  "name": "amr/{project-name}",
  "description": "AMR Tech — {descripción del proyecto}",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Amr\\{ProjectName}\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Amr\\{ProjectName}\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "test": "phpunit --testdox",
    "test-coverage": "phpunit --coverage-html coverage/",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix"
  },
  "minimum-stability": "stable"
}
