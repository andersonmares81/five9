PORT=3001
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
AUTH_MODE=jwt
AUTH_SHARED_TOKEN=

DATABASE_URL=postgres://user:password@localhost:5432/five9
# Alternatively use PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE

ENABLE_SCHEDULER=true
SYNC_CRON=*/15 * * * *

FIVE9_BASE_URL=https://app.five9.com/appsvcs/rs/svc
FIVE9_USERNAME=your-user
FIVE9_PASSWORD=your-pass
# Optional override for login payload
# FIVE9_LOGIN_PAYLOAD_JSON={"username":"user","password":"pass"}

# Required for data extraction
FIVE9_CALLS_PATH=/agents/1234/interactions/calls
FIVE9_REALTIME_PATH=/agents/realtime
FIVE9_SUPERVISOR_ID=2385
FIVE9_AGENT_IDS=1262,1270
# Optional recording view options (Five9 RecordingViewOptions)
FIVE9_RECORDING_VIEW_OPTIONS_JSON={"limit":100}
# Optional override for supervisor/recording base URLs
# FIVE9_SUP_BASE_URL=https://app.five9.com/supsvcs/rs/svc
# FIVE9_STR_BASE_URL=https://app.five9.com/strsvcs/rs/svc

# WFO/QM (VOCoreWebAPI) - temporary auth from browser or official token
WFO_ENABLED=false
WFO_BASE_URL=https://cloud1656.wfo.five9.com/VOCoreWebAPI
WFO_METHOD=POST
# Example: {"cookie":"...","apitoken":"...","x-requested-with":"XMLHttpRequest","origin":"https://cloud1656.wfo.five9.com","referer":"https://cloud1656.wfo.five9.com/"}
WFO_HEADERS_JSON={}
# Example payload from DevTools (Request Payload)
WFO_PAYLOAD_JSON={}
WFO_PAGE_SIZE=100
WFO_MAX_PAGES=50
WFO_USE_NEXT_PAGE=false

ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
